# Copy this file to .env and fill in your own keys

# Which LLM answers questions: groq (default) | huggingface | openai
LLM_PROVIDER="groq"
# Optional — override the provider's default model
# (groq: llama-3.3-70b-versatile, huggingface: Qwen/Qwen2.5-72B-Instruct, openai: required)
# LLM_MODEL=""

# Only the key for your chosen provider is needed
GROQ_API_KEY="your-groq-api-key-here"
HF_TOKEN="your-huggingface-token-here"
OPENAI_API_KEY="your-openai-api-key-here"
MISTRAL_API_KEY="your-mistral-api-key-here"
